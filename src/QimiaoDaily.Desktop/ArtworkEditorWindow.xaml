<Window x:Class="QimiaoDaily.Desktop.ArtworkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="美图元数据编辑" Width="500" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#101427">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding ArtworkEditorModeText}" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>
        <TextBlock Text="标题" Foreground="#C5CBE8"/><TextBox Text="{Binding ArtworkEditTitle,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="角色名" Foreground="#C5CBE8"/><TextBox Text="{Binding ArtworkEditCharacterName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="出处" Foreground="#C5CBE8"/><TextBox Text="{Binding ArtworkEditFranchiseName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="类别" Foreground="#C5CBE8"/><TextBox Text="{Binding ArtworkEditCategory,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="标签" Foreground="#C5CBE8"/><TextBox Text="{Binding ArtworkEditTags,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <TextBlock Text="编辑原因" Foreground="#C5CBE8"/><TextBox Text="{Binding ArtworkBatchReason,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,14"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
          <Button Content="确定并保存" Click="Save_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
