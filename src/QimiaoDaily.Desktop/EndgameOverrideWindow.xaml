<Window x:Class="QimiaoDaily.Desktop.EndgameOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="周期玩法单期调整" Width="480" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#101427">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="单期调整" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>
        <TextBlock Text="原计划日期（要调整的那一期，yyyy-MM-dd）" Foreground="#C5CBE8" TextWrapping="Wrap"/>
        <TextBox Text="{Binding EndgameOverrideScheduledDate,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="调整后日期（yyyy-MM-dd）" Foreground="#C5CBE8"/>
        <TextBox Text="{Binding EndgameOverrideDate,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="调整后的开始时间（HH:mm，可选）" Foreground="#C5CBE8"/>
        <TextBox Text="{Binding EndgameOverrideStartTime,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="调整后的结束时间（HH:mm，可选）" Foreground="#C5CBE8"/>
        <TextBox Text="{Binding EndgameOverrideEndTime,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
        <TextBlock Text="覆盖备注（可选）" Foreground="#C5CBE8"/>
        <TextBox Text="{Binding EndgameOverrideNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <TextBlock Text="保存后，当前规则的后续周期会按调整后的日期继续计算；其他规则不变。" Foreground="#9AA4D7" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
          <Button Content="确定并保存" Click="Save_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
