<Window x:Class="QimiaoDaily.Desktop.ActivityEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QimiaoDaily.Desktop.Localization"
        Title="游戏候选编辑" Width="560" Height="760" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#101427">
  <Window.Resources>
    <local:DisplayNameConverter x:Key="DisplayNameConverter"/>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <DockPanel>
      <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
        <Button Content="确定并保存" Click="Save_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
      </WrapPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="{Binding ActivityEditorModeText}" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14"/>
          <TextBlock Text="类别" Foreground="#C5CBE8"/>
          <ComboBox ItemsSource="{Binding ActivityTypeOptions}" SelectedItem="{Binding ActivityEditType}" Margin="0,4,0,10"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource DisplayNameConverter},ConverterParameter=type}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock Text="标题" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ActivityEditTitle,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="原始时间" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ActivityEditSourceTime,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="原始时区" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ActivityEditSourceTimezone,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="标准时间" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ActivityEditNormalizedText,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="结束时间" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ActivityEditEndText,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="核验状态" Foreground="#C5CBE8"/>
          <ComboBox ItemsSource="{Binding ActivityVerificationOptions}" SelectedItem="{Binding ActivityEditVerification}" Margin="0,4,0,10"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource DisplayNameConverter},ConverterParameter=status}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock Text="时间精度" Foreground="#C5CBE8"/>
          <ComboBox ItemsSource="{Binding ActivityTimePrecisionOptions}" SelectedItem="{Binding ActivityEditTimePrecision}" Margin="0,4,0,10"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource DisplayNameConverter},ConverterParameter=precision}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock Text="卡池类型（仅卡池）" Foreground="#C5CBE8"/>
          <ComboBox ItemsSource="{Binding ActivityGachaPoolKindOptions}" SelectedItem="{Binding ActivityEditGachaPoolKind}" Margin="0,4,0,10"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource DisplayNameConverter},ConverterParameter=gacha-kind}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock Text="卡池阶段（仅卡池）" Foreground="#C5CBE8"/>
          <ComboBox ItemsSource="{Binding ActivityGachaPoolPhaseOptions}" SelectedItem="{Binding ActivityEditGachaPoolPhase}" Margin="0,4,0,10"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource DisplayNameConverter},ConverterParameter=gacha-phase}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <TextBlock Text="卡池分组键（可选）" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ActivityEditGachaGroupKey,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="编辑原因" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ActivityEditReason,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,4,0,8"/>
          <TextBlock Text="保存后记录字段级修订，并自动退回待审核；正式日报不会直接读取待审核内容。" Foreground="#9AA4D7" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
