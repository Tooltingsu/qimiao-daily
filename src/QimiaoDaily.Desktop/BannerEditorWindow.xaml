<Window x:Class="QimiaoDaily.Desktop.BannerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QimiaoDaily.Desktop.Localization"
        Title="卡池编辑" Width="540" Height="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#101427">
  <Window.Resources>
    <local:DisplayNameConverter x:Key="DisplayNameConverter"/>
    <DataTemplate x:Key="GameOptionTemplate"><TextBlock Text="{Binding Converter={StaticResource DisplayNameConverter},ConverterParameter=game}"/></DataTemplate>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <DockPanel>
      <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
        <Button Content="确定并保存" Click="Save_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
      </WrapPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="{Binding ManualBannerEditorModeText}" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
          <TextBlock Text="所属游戏" Foreground="#C5CBE8"/>
          <ComboBox ItemsSource="{Binding ManualGameOptions}" ItemTemplate="{StaticResource GameOptionTemplate}" SelectedItem="{Binding ManualGame,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="卡池名称（日报显示名称）" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ManualBannerName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="卡池类型" Foreground="#C5CBE8"/>
          <ComboBox ItemsSource="{Binding ManualBannerTypeOptions}" SelectedItem="{Binding ManualBannerType,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
          <TextBlock Text="角色（按显示顺序逐行填写）" Foreground="#C5CBE8"/>
          <ItemsControl ItemsSource="{Binding BannerCharacterEditors}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Content="删除角色" Command="{Binding DataContext.RemoveBannerCharacterCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="6,0,0,0" Padding="7,3" Background="#4D3C61" Foreground="White"/>
                  <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="添加角色" Command="{Binding AddBannerCharacterCommand}" HorizontalAlignment="Left" Padding="8,4" Margin="0,4,0,10" Background="#323A67" Foreground="White"/>
          <TextBlock Text="开始日期时间（Asia/Shanghai，yyyy-MM-dd HH:mm）" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ManualBannerStart,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" ToolTip="仅填写日期时默认 04:00"/>
          <TextBlock Text="结束日期时间（Asia/Shanghai，yyyy-MM-dd HH:mm）" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ManualBannerEnd,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" ToolTip="仅填写日期时默认 03:59"/>
          <TextBlock Text="备注（可选）" Foreground="#C5CBE8"/>
          <TextBox Text="{Binding ManualBannerNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,4,0,4"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
