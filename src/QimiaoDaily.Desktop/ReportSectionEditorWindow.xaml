<Window x:Class="QimiaoDaily.Desktop.ReportSectionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日报段落编辑" Width="640" Height="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#101427">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="9"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <DockPanel>
      <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
        <Button Content="确定并保存" Click="Save_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
      </WrapPanel>
      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="{Binding DisplayName}" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="修改该段落后将转为手工内容；可在主页面恢复自动生成。" Foreground="#9AA4D7" TextWrapping="Wrap" Margin="0,6,0,10"/>
      </StackPanel>
      <TextBox Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
  </Border>
</Window>
