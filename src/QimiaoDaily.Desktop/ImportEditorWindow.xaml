<Window x:Class="QimiaoDaily.Desktop.ImportEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入活动数据" Width="620" Height="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="#101427">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <DockPanel>
      <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
        <Button Content="生成预览" Click="Preview_Click" Padding="12,5" Margin="8,0,0,0" Background="#323A67" Foreground="White"/>
        <Button Content="确定导入" Click="Confirm_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
      </WrapPanel>
      <StackPanel>
        <TextBlock Text="导入活动、卡池、版本、生日与纪念日" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="粘贴 Codex 整理的 JSON，先生成预览，再勾选需要写入的项目。" Foreground="#9AA4D7" TextWrapping="Wrap" Margin="0,6,0,10"/>
        <TextBox Text="{Binding ImportJsonText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="导入预览" Foreground="#F5C67F" FontWeight="SemiBold" Margin="0,12,0,6"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ImportPreviewEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#222A49" BorderBrush="#39466F" BorderThickness="1" Padding="8" Margin="0,0,0,5">
                  <StackPanel>
                    <CheckBox Content="{Binding NaturalKey}" IsChecked="{Binding IsSelected}" Foreground="White"/>
                    <TextBlock Text="{Binding Change}" Foreground="#AAB7E9" FontSize="11" Margin="24,2,0,0"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
