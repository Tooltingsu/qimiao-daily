    <Border DataContext="{Binding DataContext,ElementName=RootWindow}" Visibility="{Binding IsEvidenceOpen,Converter={StaticResource BoolVisibility}}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,18,0" Panel.ZIndex="10">
      <Border Width="470" MaxHeight="720" Style="{StaticResource Panel}">
        <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"><TextBlock Text="证据详情" FontSize="19" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding SelectedEvidence.Title}" Foreground="#F5C67F" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/><Button Content="关闭" Command="{Binding CloseEvidenceCommand}" Margin="12,0,0,0" Padding="7,3" Background="#4D3C61" Foreground="White"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding SelectedEvidence.DisplayGame,StringFormat=游戏：{0}}" Foreground="#AEB7E9"/><TextBlock Text="{Binding SelectedEvidence.DisplayType,StringFormat=类型：{0}}" Foreground="#AEB7E9"/><TextBlock Text="{Binding SelectedEvidence.Provider,StringFormat=来源：{0}}" Foreground="#8EE5D4" Margin="0,6,0,0"/><TextBlock Text="{Binding SelectedEvidence.SourceUrl,StringFormat=URL：{0}}" Foreground="#8EE5D4" TextWrapping="Wrap"/><Button Content="打开来源" Command="{Binding OpenEvidenceSourceCommand}" CommandParameter="{Binding SelectedEvidence.SourceUrl}" HorizontalAlignment="Left" Margin="0,5,0,0" Padding="7,3" Background="#365E68" Foreground="White"/><Button Content="编辑候选" Command="{Binding EditActivityCommand}" CommandParameter="{Binding SelectedEvidence.Id}" HorizontalAlignment="Left" Margin="0,5,0,0" Padding="7,3" Background="#4D3C61" Foreground="White"/><TextBlock Text="{Binding SelectedEvidence.OriginalTime,StringFormat=原始时间：{0}}" Foreground="#C8D0EF" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedEvidence.NormalizedTime,StringFormat=标准时间：{0}}" Foreground="#C8D0EF"/><TextBlock Text="{Binding SelectedEvidence.PublishedAt,StringFormat=发布时间：{0}}" Foreground="#C8D0EF"/><TextBlock Text="{Binding SelectedEvidence.FetchedAt,StringFormat=抓取时间：{0}}" Foreground="#C8D0EF"/><TextBlock Text="{Binding SelectedEvidence.Timezone,StringFormat=时区：{0}}" Foreground="#C8D0EF"/><TextBlock Text="{Binding SelectedEvidence.ParserVersion,StringFormat=解析器：{0}}" Foreground="#C8D0EF"/><TextBlock Text="{Binding SelectedEvidence.DisplayVerification,StringFormat=核验：{0}}" Foreground="#8EE5CB" Margin="0,8,0,0"/><TextBlock Text="原始证据" Foreground="#F5C67F" Margin="0,10,0,3"/><TextBlock Text="{Binding SelectedEvidence.SourceText}" Foreground="#E4E8FA" TextWrapping="Wrap"/><TextBlock Text="修订记录" Foreground="#F5C67F" Margin="0,10,0,3"/><TextBlock Text="{Binding SelectedEvidence.History}" Foreground="#E4E8FA" TextWrapping="Wrap"/></StackPanel></ScrollViewer></DockPanel>
      </Border>
    </Border>
    
  </Grid>
</Window>
