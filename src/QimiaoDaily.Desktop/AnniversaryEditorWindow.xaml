<Window x:Class="QimiaoDaily.Desktop.AnniversaryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="纪念日编辑" Width="450" SizeToContent="Height" MinHeight="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#101427">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <StackPanel>
      <TextBlock Text="纪念日编辑" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,16"/>
      <TextBlock Text="纪念日名称" Foreground="#C5CBE8"/>
      <TextBox Text="{Binding AnniversaryTitle,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
      <TextBlock Text="起始日期（yyyy-MM-dd）" Foreground="#C5CBE8"/>
      <TextBox Text="{Binding AnniversaryStartedOn,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
      <TextBlock Text="备注（可选）" Foreground="#C5CBE8"/>
      <TextBox Text="{Binding AnniversaryNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,4,0,16"/>
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
        <Button Content="保存" Click="Save_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
