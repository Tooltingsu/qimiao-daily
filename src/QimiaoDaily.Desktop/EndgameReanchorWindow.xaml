<Window x:Class="QimiaoDaily.Desktop.EndgameReanchorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="周期玩法重新锚定" Width="460" SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#101427">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151A2F"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#5A6FA8"/><Setter Property="Padding" Value="7,4"/></Style>
  </Window.Resources>
  <Border Background="#1A203A" BorderBrush="#3B4771" BorderThickness="1" CornerRadius="10" Padding="20" Margin="8">
    <StackPanel>
      <TextBlock Text="重新锚定周期规则" FontSize="19" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
      <TextBlock Text="新锚点日期（周期计算起点，yyyy-MM-dd）" Foreground="#C5CBE8" TextWrapping="Wrap"/>
      <TextBox Text="{Binding EndgameAnchorDate,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
      <TextBlock Text="只会重算当前规则的当前期和之后两期；其他周期规则不受影响。" Foreground="#9AA4D7" TextWrapping="Wrap" Margin="0,0,0,16"/>
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="取消" Click="Cancel_Click" Padding="12,5" Background="#323A67" Foreground="White"/>
        <Button Content="确定并保存" Click="Save_Click" Padding="12,5" Margin="8,0,0,0" Background="#365E68" Foreground="White"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
